# Copy to .env and adjust. Never commit the real .env file.
POSTGRES_USER=shortlink
POSTGRES_PASSWORD=shortlink
POSTGRES_DB=shortlink

# Local run (services on your machine). In Docker Compose and Kubernetes the
# hostnames change from localhost to the service names (postgres, redis).
DATABASE_URL=postgresql://shortlink:shortlink@localhost:5432/shortlink
REDIS_URL=redis://localhost:6379/0
BASE_URL=http://localhost:8001
STREAM_NAME=clicks
